{
  "name": "dsh-web-fetch-moli",
  "version": "0.6.1",
  "description": "Moli (ultra-lightweight Rust headless browser) web-fetch provider for DeepSeek Harness: renders complex SPAs, micro-frontends, and static pages with ~60MB memory.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --emitDeclarationOnly && tsdown",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "RUN_ONLINE_BENCHMARK=true vitest run tests/bailian-benchmark.spec.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "engines": {
      "dsh": ">=0.1.7-alpha.1"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "moli",
    "cdp",
    "web-fetch",
    "fetch-provider",
    "markdown",
    "rust-headless-browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreyRaphael/dsh-web-fetch-moli.git"
  },
  "homepage": "https://github.com/GreyRaphael/dsh-web-fetch-moli#readme",
  "bugs": {
    "url": "https://github.com/GreyRaphael/dsh-web-fetch-moli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "disclosure": {
    "cloud": false,
    "network": [],
    "offlineMode": false,
    "apiKeys": [],
    "permissions": [
      "network:fetch (renders the URLs the user requests in local Moli or CDP, including CDP profile mode with remote browser sessions)",
      "network:connect (user-configured or managed CDP endpoint)",
      "fs:read (user-configured moli executable path)"
    ],
    "jurisdiction": [],
    "retention": "none"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.3 <4",
    "@mdream/js": "^1.7.2",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.14"
  },
  "optionalDependencies": {
    "mdream": "^1.7.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.3 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-web": ">=0.1.7-alpha.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-web": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3"
  }
}
