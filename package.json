{
  "name": "dsh-web-fetch-moli",
  "version": "0.1.0",
  "description": "Moli (ultra-lightweight Rust headless browser) web-fetch provider for DeepSeek Harness: renders complex SPAs, micro-frontends, and static pages with ~60MB memory.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --emitDeclarationOnly && tsdown",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "RUN_ONLINE_BENCHMARK=true vitest run tests/bailian-benchmark.spec.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "moli",
    "cdp",
    "web-fetch",
    "fetch-provider",
    "markdown",
    "rust-headless-browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreyRaphael/dsh-web-fetch-moli.git"
  },
  "homepage": "https://github.com/GreyRaphael/dsh-web-fetch-moli#readme",
  "bugs": {
    "url": "https://github.com/GreyRaphael/dsh-web-fetch-moli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "disclosure": {
    "cloud": false,
    "network": [],
    "offlineMode": false,
    "apiKeys": [],
    "permissions": [
      "network:fetch (renders the URLs the user requests in local Moli or CDP)",
      "network:connect (user-configured or managed CDP endpoint)",
      "fs:read (user-configured moli executable path)",
      "network:fetch (CDP profile mode: renders URLs with remote browser sessions)"
    ],
    "jurisdiction": [],
    "retention": "none"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.2 <4",
    "@joplin/turndown-plugin-gfm": "^1.0.56",
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.2.4",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.50.0",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-web": ">=0.1.2-alpha.0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-web": "0.1.2-alpha.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
